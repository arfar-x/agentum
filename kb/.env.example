# The knowledge catalog's variables -- every one of them, and the only ones kb
# reads. Copy to kb/.env.kb (gitignored); `make up` does that for you, generates
# the two database passwords, and seeds the rest from an older root .env if it
# finds KB_* values there.
#
# This file is read by exactly three things: the kb services that sync
# (kb-scheduler, kb-cli, kb-webhook) as their environment, the compose file as
# its interpolation source, and kb/scripts/*. The query path (mcp-kb) is given
# an explicit short list instead and never sees this file (NFR-CFG-03).
#
# Plain KEY=value lines. No ${VAR} references to other files: this module does
# not read the stack's .env, so anything it needs from there is set below.

### ---- Database ----
# Its own Postgres instance (service `kb-db`), separate from LibreChat's
# `vectordb` on purpose -- see docs/SPEC.md. Create the schema and the
# read-only role with `make kb-init` (also run by `make up`).
KB_POSTGRES_DB=agentflow_kb
KB_POSTGRES_USER=kb
# Owner credential: sync writes as this. Generated by `make up` when empty.
KB_POSTGRES_PASSWORD=
# The least-privilege role the query path connects as: it may read the catalog
# and append to the gap log, nothing else. Never give the query path the owner
# credential above. Generated by `make up` when empty.
KB_READER_PASSWORD=

### ---- What sync reads ----
# Sync needs a READ-ONLY SERVICE ACCOUNT: it has to see a space to catalog it.
# This is not the per-user credential an agent uses to read a page later -- that
# check still happens at the source, as the user. Set the values for every
# source type kb/config/sources.yaml enables: a base URL plus a PAT or a
# username/password pair.
# KB_CONFLUENCE_BASE_URL=
# KB_CONFLUENCE_USERNAME=
# KB_CONFLUENCE_PASSWORD=
# KB_CONFLUENCE_PAT=
# KB_CONFLUENCE_DEPLOYMENT_TYPE=server
# KB_JIRA_BASE_URL=
# KB_JIRA_USERNAME=
# KB_JIRA_PASSWORD=
# KB_JIRA_PAT=
# A read-only GitLab token (api or read_api scope) for repositories listed in
# kb/config/sources.yaml. The file names the token's variable (`token_env:`);
# the value lives here.
# GITLAB_BASE_URL=
# GITLAB_TOKEN=
# Discovery (`make kb-sources-discover`) also accepts these spellings:
# KB_GITLAB_BASE_URL=
# KB_GITLAB_TOKEN=

# The kill switch: false stops every source syncing, without editing
# kb/config/sources.yaml. The environment wins over the file, and every command
# reports which one it used.
# KB_SOURCES_APPROVED=true

### ---- How it describes what it reads (the summarizer) ----
# Any OpenAI-compatible endpoint: the URL is the BASE, ending in /v1, not the
# /chat/completions path (a pasted full endpoint is accepted and trimmed).
# `make kb-check` asks it GET <url>/models and reports whether it answered and
# whether it serves the model below -- configured is not the same as working.
#
# Unset, sync still runs: documents are catalogued under their real titles but
# undescribed, and cross-language search will not work.
KB_SUMMARIZER_URL=https://your-vllm-host/v1
# The model id the endpoint actually serves (see its GET /v1/models).
KB_SUMMARIZER_MODEL=
# Optional. Sent as `Authorization: Bearer ...` when set, and omitted entirely
# when empty -- plenty of self-hosted endpoints need no key at all.
KB_SUMMARIZER_API_KEY=
# Optional: pin the endpoint's host to a fixed IP inside the kb containers, for
# when that host doesn't resolve from your box the way the endpoint needs. Both
# must be non-empty (an empty value breaks `docker compose config`); if you
# don't need a pin, leave these placeholders -- they are harmless.
KB_SUMMARIZER_HOSTNAME=your-model-host
KB_SUMMARIZER_HOST_IP=192.0.2.1

# What language(s) every entry is catalogued in. Two is what lets a question in
# one find a document written in the other.
KB_SUMMARY_LANGUAGES=en
# IANA timezone for scheduled work: `at: "03:00"` in kb/config/sources.yaml
# means 03:00 here. Everything else compares instants, so this only affects
# times of day. Default UTC.
KB_TIMEZONE=UTC

### ---- GitLab push events (optional) ----
# `docker compose --profile webhook up -d`. Without a secret the receiver
# refuses to start rather than accept unauthenticated requests. Set the same
# value in GitLab's webhook settings.
# KB_WEBHOOK_SECRET=
# Host port the receiver is published on (127.0.0.1 only).
# KB_WEBHOOK_PORT=8323

### ---- Admin console (optional) ----
# `make kb-admin-up`; see docs/OPERATOR_GUIDE.md "The admin console". One shared
# token opens it and it refuses to start without one. The console connects to
# the catalog's database as its own role, kb_admin, which reads everything and
# writes only the console's own tables -- never give it the owner credential. It
# is published on 127.0.0.1 only; put a TLS-terminating proxy in front before
# changing KB_ADMIN_BIND, and then set KB_ADMIN_COOKIE_SECURE=true.
# `make kb-admin-up` generates the first two when they are empty.
# KB_ADMIN_TOKEN=
# KB_ADMIN_DB_PASSWORD=
# KB_ADMIN_PORT=8324
# KB_ADMIN_BIND=127.0.0.1
# KB_ADMIN_COOKIE_SECURE=false
# KB_ADMIN_SESSION_HOURS=12
# The reverse proxy's address, if there is one.
# KB_ADMIN_FORWARDED_ALLOW_IPS=
# Run the console as the owner of kb/config/sources.yaml (uid:gid) instead of
# root, if you would rather not give it root to rewrite that file.
# KB_ADMIN_USER=0:0
