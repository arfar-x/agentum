# agentflow -- copy to .env, fill in real values, chmod 600.
# See docs/CONFIGURATION.md for what every variable does and what breaks
# if it's wrong.

### ---- LibreChat / port ----
PORT=3080
# Both images are the STABLE (tagged-release) channel, not the -dev image
# that tracks the main branch on every merge --
# registry.librechat.ai/librechat-ai/librechat vs. .../librechat-dev. Check
# for newer tags at https://github.com/LibreChat-AI/LibreChat/releases
# before upgrading, and read that release's UPGRADING.md -- some upgrades
# need a one-off migration (see docs/OPERATIONS.md "Upgrades").
LIBRECHAT_IMAGE_TAG=v0.8.8
RAG_API_IMAGE_TAG=v0.9.0

### ---- Secrets (generate with scripts/generate-secrets.sh -- do not hand-edit) ----
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=

### ---- Mongo (auth is ON in this compose file, unlike LibreChat's upstream default) ----
MONGO_ROOT_USERNAME=agentflow_root
MONGO_ROOT_PASSWORD=
# App-level user LibreChat itself authenticates as; create it once Mongo is
# up (docs/OPERATIONS.md) then reference it here.
MONGO_APP_USERNAME=librechat
MONGO_APP_PASSWORD=
# MONGO_URI is built from the two variables above directly in
# docker-compose.yml (not here) -- .env's own variable interpolation is a
# single top-down pass, so building it here is order-sensitive in a way
# that silently breaks if a value gets pasted in below this line instead
# of edited in place above.

### ---- Meilisearch ----
MEILI_MASTER_KEY=

### ---- SearXNG (web search) ----
# In-Docker address LibreChat's api reaches SearXNG at (backend compose
# network, no published port). Must match webSearch.allowedAddresses in
# config/librechat.yaml. SearXNG is free/open -- no API key.
SEARXNG_INSTANCE_URL=http://searxng:8080

# Page scraper behind web search: the in-Docker crw service (a self-hosted,
# Firecrawl-compatible scraper -- see docker-compose.yml). LibreChat reads
# these two names for its Firecrawl scraper. The key is a placeholder, not a
# secret: crw runs without auth on its own network, but LibreChat refuses
# to scrape with an empty Firecrawl key. Must match webSearch.allowedAddresses
# in config/librechat.yaml.
FIRECRAWL_API_URL=http://crw:3000
FIRECRAWL_API_KEY=self-hosted

### ---- pgvector (RAG) ----
POSTGRES_DB=agentflow_rag
POSTGRES_USER=agentflow
POSTGRES_PASSWORD=
# Must be an embeddings model your vLLM/embedding endpoint actually serves.
RAG_EMBEDDINGS_PROVIDER=openai
RAG_EMBEDDINGS_MODEL=

### ---- Knowledge base (kb) ----
# Its own Postgres instance (service `kb-db`), separate from LibreChat's
# `vectordb` on purpose -- see docs/spec/knowledge-base.md. Create the schema
# and the read-only role with `make kb-init` after the stack is up.
KB_POSTGRES_DB=agentflow_kb
KB_POSTGRES_USER=kb
KB_POSTGRES_PASSWORD=
# The least-privilege role the query path connects as: it may read the catalog
# and append to the gap log, nothing else. Never give the query path the owner
# credential above.
KB_READER_PASSWORD=

# --- what sync reads, and how it describes it ---
# Sync needs a READ-ONLY SERVICE ACCOUNT: it has to see a space to catalog it.
# This is not the per-user credential an agent uses to read a page later -- that
# check still happens at the source, as the user. Set the KB_* values for every
# source type config/kb-sources.yaml enables: a base URL plus a PAT or a
# username/password pair.
# KB_CONFLUENCE_BASE_URL=
# KB_CONFLUENCE_USERNAME=
# KB_CONFLUENCE_PASSWORD=
# KB_CONFLUENCE_PAT=
# KB_JIRA_BASE_URL=
# KB_JIRA_USERNAME=
# KB_JIRA_PASSWORD=
# KB_JIRA_PAT=
# A read-only GitLab token (api or read_api scope) for repositories listed in
# config/kb-sources.yaml. The file names this variable; the value lives here.
# GITLAB_BASE_URL=
# GITLAB_TOKEN=
#
# What language(s) every entry is catalogued in. Two is what lets a question in
# one find a document written in the other. The summarizer that writes them is
# configured below, after VLLM_BASE_URL -- .env interpolates in one top-down
# pass, so it has to come after the variables it references.
KB_SUMMARY_LANGUAGES=en
# IANA timezone for scheduled work: `at: "03:00"` in config/kb-sources.yaml
# means 03:00 here. Everything else compares instants, so this only affects
# times of day. Default UTC.
KB_TIMEZONE=UTC
#
# The kill switch: false stops every source syncing, without editing
# config/kb-sources.yaml. The environment wins over the file, and every command
# reports which one it used.
# KB_SOURCES_APPROVED=true
#
# GitLab push events (optional, `docker compose --profile webhook up -d`).
# Without a secret the receiver refuses to start rather than accept
# unauthenticated requests. Set the same value in GitLab's webhook settings.
# KB_WEBHOOK_SECRET=
# KB_WEBHOOK_PORT=8323
#
# The admin console (optional, `make kb-admin-up`; see docs/KNOWLEDGE_BASE.md
# "Admin console"). One shared token opens it; it refuses to start without one.
# The console connects to the catalog's database as its own role, kb_admin,
# which reads everything and writes only the console's own tables -- never give
# it the owner credential. It is published on 127.0.0.1 only; put a
# TLS-terminating proxy in front before changing KB_ADMIN_BIND, and then set
# KB_ADMIN_COOKIE_SECURE=true. `scripts/generate-secrets.sh` generates both.
# KB_ADMIN_TOKEN=
# KB_ADMIN_DB_PASSWORD=
# KB_ADMIN_PORT=8324
# KB_ADMIN_BIND=127.0.0.1
# KB_ADMIN_COOKIE_SECURE=false
# KB_ADMIN_SESSION_HOURS=12
# Run the console as the owner of config/kb-sources.yaml (uid:gid) instead of
# root, if you would rather not give it root to rewrite that file.
# KB_ADMIN_USER=0:0

### ---- LLM endpoint (vLLM, OpenAI-compatible) ----
# An endpoint can advertise a model id that names a different model than
# what it actually serves (e.g. a proxy relabeling a self-hosted model to
# match a well-known name) -- config/librechat.yaml treats VLLM_DEFAULT_MODEL
# below as an opaque label either way and declares context length explicitly
# rather than trusting the name. See docs/CONFIGURATION.md.
VLLM_BASE_URL=https://your-vllm-host/v1
VLLM_API_KEY=
# The model id this endpoint's backend actually serves (see its
# GET /v1/models). config/librechat.yaml.example's `default`, `titleModel`
# and `tokenConfig` key are all rendered from this one value -- change the
# model here, not in the generated config/librechat.yaml (see
# scripts/render-librechat-config.sh).
VLLM_DEFAULT_MODEL=your-model-id
# The real context window (tokens) of the model actually being served --
# not necessarily what the endpoint advertises (see the id-trap note
# above). Single source of truth for config/librechat.yaml's
# tokenConfig.context AND for summarization.retainRecent.tokens, which is
# derived from this as a fixed percentage at render time -- so raising or
# lowering this one number is all that's needed to rescale auto-compact's
# retention budget to match, instead of hand-tuning a second value.
MODEL_CONTEXT_TOKENS=262144
# ---- The knowledge base's summarizer ----
# Any OpenAI-compatible endpoint: the URL is the BASE, ending in /v1, not the
# /chat/completions path (a pasted full endpoint is accepted and trimmed).
# `make kb-check` asks it GET <url>/models and reports whether it answered and
# whether it serves the model below -- configured is not the same as working.
#
# Unset, sync still runs: documents are catalogued under their real titles but
# undescribed, and cross-language search will not work.
KB_SUMMARIZER_URL=${VLLM_BASE_URL}
# The model id the endpoint actually serves (see its GET /v1/models).
KB_SUMMARIZER_MODEL=
# Optional. Sent as `Authorization: Bearer ...` when set, and omitted entirely
# when empty -- plenty of self-hosted endpoints need no key at all. It is its
# own variable so the catalog can use a different credential from the chat
# endpoint, or none; the default below just inherits that one.
KB_SUMMARIZER_API_KEY=${VLLM_API_KEY}

# Optional: pin VLLM_BASE_URL's host to a fixed IP inside the api + rag_api
# containers (wired via extra_hosts in docker-compose.yml). Use it when that
# host doesn't resolve from your box the way the model endpoint needs. Both
# must be non-empty (an empty value breaks `docker compose config`); if you
# don't need it, leave the placeholders -- they're harmless.
MODEL_HOSTNAME=your-model-host
MODEL_HOST_IP=192.0.2.1

### ---- MCP: agent-skills ----
# Space-separated toolset names, each needing skills/<name>/requirements.txt
# installed into the mcp-agent-skills image.
MCP_TOOLSETS="jira confluence glab"

# Jira and Confluence (skills/jira/SKILL.md, skills/confluence/SKILL.md).
# Each user's base URL, username, password and default project/space are not
# set here: they come from that user's own MCP settings in the chat UI
# (customUserVars in config/librechat.yaml.example, sent with every request).
# There is no shared fallback identity -- a user who hasn't entered theirs has
# no Jira/Confluence tools. Only deployment-wide toolset settings live here.
#
# optional -- true skips the confirm step before writes; leave unset/false
# in production so LibreChat's own toolApproval is the only gate.
JIRA_AUTO_CONFIRM_WRITES=false
# optional -- only required the first time create_issue/edit_issue sets an assignee
JIRA_DEPLOYMENT_TYPE=
# optional -- same as JIRA_AUTO_CONFIRM_WRITES, for Confluence writes.
CONFLUENCE_AUTO_CONFIRM_WRITES=false
# required -- cloud or server. Confluence's REST API is mounted at a
# different path per deployment (Cloud: /wiki/rest/api, Server/DC: /rest/api)
CONFLUENCE_DEPLOYMENT_TYPE=

# GitLab (skills/glab/SKILL.md): per-user like Jira -- base URL and personal
# access token come from each user's MCP settings, and are optional by
# convention (`-` in each field; see docs/CONFIGURATION.md). These GITLAB_*
# toolset settings are separate from the kb's GITLAB_BASE_URL/GITLAB_TOKEN
# service account above: mcp-agent-skills never sees that token (it gets only
# the few settings docker-compose.yml lists, not this file), so no glab_*
# call can run as the service account.
# optional -- same as JIRA_AUTO_CONFIRM_WRITES, for merge-request comments.
GITLAB_AUTO_CONFIRM_WRITES=false

### ---- Agents (LibreChat's agents endpoint) ----
# How many tool-call steps a single agent run may take before LibreChat
# aborts it (GraphRecursionError). recursionLimit is the default a run
# starts with; maxRecursionLimit is the ceiling a user can raise it to
# from the UI. config/librechat.yaml.example has REPLACE_ME_* placeholders
# for both, rendered into config/librechat.yaml by `make up` / `make
# render-config` -- edit these values here, not in config/librechat.yaml
# directly.
AGENTS_RECURSION_LIMIT=50
AGENTS_MAX_RECURSION_LIMIT=100
# Scheduled Chats (enabled in config/librechat.yaml.example's
# interface.schedules). Without a shared stream store LibreChat refuses to arm
# the scheduler unless told this is the only LibreChat process -- true here:
# one `api` replica. Set it back to false (or remove it) before ever running a
# second api replica; SCHEDULES_DISABLED=true is the emergency stop for all runs.
SCHEDULES_SINGLE_PROCESS=true
# Shared generation store (the `redis` service). Needed for a scheduled run of
# an agent that can pause -- one with ask_user_question or a tool on
# toolApproval's `ask` list; without it that run fails with "Scheduled agent
# runs that can pause require a shared generation store". Defaults to true.
# USE_REDIS=true and REDIS_URI=redis://redis:6379 (both needed for it to take
# effect) are fixed in docker-compose.yml, not here -- compose overrides .env,
# so setting them in this file does nothing. With this on, SCHEDULES_SINGLE_PROCESS
# above is no longer required, but harmless.
USE_REDIS_STREAMS=true

### ---- Auth: local (default) ----
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=false
# Login lifetime, in milliseconds: 604800000 = 7 days, 900000 = 15 minutes.
# Plain numbers on purpose -- scripts/ `source .env` in bash, where an
# arithmetic expression like `1000 * 60` would glob or run as a command.
# REFRESH_TOKEN_EXPIRY is how long a login lasts: users sign in again once a
# week. It's absolute -- refreshing never pushes it out, so an active user is
# still asked to log in 7 days after they last did. SESSION_EXPIRY is the
# short-lived access token, renewed silently from the refresh token while the
# login is valid; keep it short. Both equal LibreChat's defaults.
REFRESH_TOKEN_EXPIRY=604800000
SESSION_EXPIRY=900000
# Whether the login (refresh) cookie is marked Secure. Browsers drop Secure
# cookies received over plain HTTP, and `api` runs with NODE_ENV=production
# (which makes LibreChat set Secure unless told otherwise), so over http://<ip>
# the login is lost ~15 minutes after sign-in. false while the UI is served over
# plain HTTP, as `api`'s published port is; true once TLS terminates in front.
# Unset means false.
SESSION_COOKIE_SECURE=false

# First/admin account -- created automatically by scripts/bootstrap.sh
# (docs/OPERATIONS.md "First run"), not through the UI, since
# ALLOW_REGISTRATION is false. Use a generic address you control
# (a shared team inbox, or a .local/.internal placeholder that's never
# actually sent mail), not a real person's personal email -- this is a
# service account for the deployment, not tied to one individual.
ADMIN_EMAIL=admin@agentflow.local
ADMIN_NAME=Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

### ---- Admin panel (github.com/ClickHouse/librechat-admin-panel) ----
# Separate service, bundled below in docker-compose.yml. Needs LibreChat
# v0.8.5+. Admin access is checked by `api` itself (role: 'ADMIN' in
# Mongo, or the access:admin grant) -- the panel can't grant itself
# privileges. The first user registered in this (unscoped, single-tenant)
# deployment is auto-admin, so ADMIN_EMAIL above already qualifies.
# Min 32 chars. Generate with: openssl rand -hex 32
ADMIN_PANEL_SESSION_SECRET=
# Host port for the admin panel UI; defaults to 3000 if unset.
ADMIN_PANEL_PORT=3000

### ---- Auth: Keycloak OIDC (optional -- see docs/KEYCLOAK.md) ----
# Uncomment this whole block and set ALLOW_EMAIL_LOGIN=false above to
# switch. No rebuild needed -- restart the api service.
# ALLOW_SOCIAL_LOGIN=true
# ALLOW_SOCIAL_REGISTRATION=true
# OPENID_ISSUER=https://<keycloak-host>/realms/<realm>
# OPENID_CLIENT_ID=librechat
# OPENID_CLIENT_SECRET=
# OPENID_CALLBACK_URL=/oauth/openid/callback
# OPENID_SCOPE="openid profile email"
# OPENID_SESSION_SECRET=
# OPENID_REQUIRED_ROLE=librechat-user
# OPENID_REQUIRED_ROLE_PARAMETER_PATH=realm_access.roles
# OPENID_REQUIRED_ROLE_TOKEN_KIND=access
# OPENID_USE_END_SESSION_ENDPOINT=true

# ---- Agent import (`make agent-import`) -- all optional -----------------------
# Apply to every agent import on THIS deployment, so the files under agents/ can
# stay exactly as committed instead of being edited to fit each environment. A
# value given on the command line (`make agent-import MODEL_NAME=...`) wins over
# these. See docs/AGENT_SYNC.md.
#
# Own every imported agent as this account (must exist). Unset: the agent's
# current owner, else ADMIN_EMAIL above, else the oldest admin.
# OWNER_EMAIL=
# Use this provider/model for every imported agent instead of the ones in the
# files. Unset: the file's, falling back to this instance's default when the
# file's don't exist here (the import lists those to review in the UI).
# MODEL_PROVIDER=
# MODEL_NAME=
