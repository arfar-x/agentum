# agentflow's LibreChat config template. `make up` (via
# scripts/render-librechat-config.sh) renders this to config/librechat.yaml
# (gitignored, re-rendered every run) with the REPLACE_ME_* placeholders
# below filled in from .env -- that rendered file is what's actually
# mounted read-only into the api container at /app/librechat.yaml. Edit
# THIS file, never config/librechat.yaml directly -- direct edits there are
# overwritten on the next `make up` / `make render-config`. See
# docs/CONFIGURATION.md for the reasoning behind each non-obvious setting
# below.

version: 1.3.17
cache: true

# Scheduled Chats (LibreChat v0.8.8, beta): users schedule an agent prompt to
# run on a cron. Upstream ships it off; `true` turns it on with LibreChat's
# default limits (an object form with maxPerUser, minIntervalMinutes, ... is
# also accepted -- see upstream librechat.example.yaml). The boolean form
# writes nothing into role permissions, and listing only `schedules` here
# doesn't disturb the rest of the interface: LibreChat fills every unset
# interface field from its own defaults at startup.
#
# The scheduler needs SCHEDULES_SINGLE_PROCESS=true (.env) -- this stack runs
# exactly one api. A scheduled run can't get a human answer, so an agent that
# can pause (ask_user_question, or a tool on toolApproval's `ask` list) is only
# allowed to run on a schedule with the shared generation store, i.e. the
# `redis` service plus USE_REDIS_STREAMS=true; it still can't have the pause
# answered, so schedule read-only work.
interface:
  schedules: true
  # Agent creation for every role, including USER. LibreChat writes this into
  # the role permissions at each startup (so it overrides an Admin Panel edit
  # of AGENTS.CREATE). `share`/`public` are deliberately left out: when absent,
  # each role keeps its stored value -- USER can't share (its agents stay
  # private to their owner), ADMIN keeps sharing. Who sees which agent is the
  # per-agent ACL: an owner manages their own; ADMIN's manage:agents system
  # grant sees and edits every agent; an admin agent reaches users only when
  # shared with them (the Share dialog, or `sharing:` in agents/*.yaml).
  agents:
    create: true

# Memories. LibreChat treats a MISSING `memory:` block as "memory disabled":
# users could still add memories in the Memories panel, but none was ever put
# into a conversation's context. This block turns that on. Memories a user
# saves (or edits) are injected into every run of theirs -- plain chats and
# agents (an agent's memory_scope picks its pool) -- unless they opt out under
# Settings > Personalization. No `agent:` here, so nothing writes memories
# automatically from chat; add `agent: { enabled: true, provider, model }`
# to have a model extract them after each turn (one extra LLM call per turn).
memory:
  disabled: false
  personalize: true

# Auto-compact: once a conversation's history approaches the model's
# context window, LibreChat summarizes the older turns into one checkpoint
# instead of erroring or silently dropping messages -- the checkpoint plus
# retainRecent's verbatim tail is what actually gets sent on the next turn.
# provider/model are deliberately omitted so it reuses whichever agent/model
# is active (the "OpenAI Compatible" Qwen endpoint here) rather than
# hardcoding a second one -- there's only one endpoint in this deployment
# anyway. Needs `make render-config` + `make restart SERVICE=api` to pick up
# a change, like every other static part of this file.
#
# retainRecent.tokens has no ratio field of its own in LibreChat's schema
# (unlike trigger.type: token_ratio, which already scales with whatever
# context the active model has) -- REPLACE_ME_SUMMARIZATION_RETAIN_TOKENS
# is this repo's own stand-in for that: render-librechat-config.sh derives
# it as a fixed percentage of MODEL_CONTEXT_TOKENS (.env), so it tracks the
# real context window below instead of needing to be hand-tuned every time
# that number changes.
summarization:
  enabled: true
  retainRecent:
    turns: 2      # newest complete user/assistant turns kept verbatim
    tokens: REPLACE_ME_SUMMARIZATION_RETAIN_TOKENS  # ...and up to this many recent tokens on top of that

# LibreChat's SSRF protection blocks MCP servers on private/internal
# addresses by default -- mcp-agent-skills is exactly that (a Docker
# service name on the backend compose network), so it needs an explicit
# exemption. allowedAddresses (not allowedDomains) exempts just this one
# address while leaving the default SSRF block active for everything else
# a user might try to add.
# Tool Library contents. LibreChat's built-in tool manifest (Google, DALL-E,
# Wolfram, Tavily, Flux, OpenWeather, ...) needs each user's own third-party
# API key and sends their data to that service, so only the keyless,
# in-process ones are listed. includedTools is an allowlist: anything not
# named here is hidden from the Tool Library and refused at run time. To
# offer a hidden tool again, add its key (api/app/clients/tools/manifest.json
# in LibreChat, e.g. `google`, `dalle`, `wolfram`) and restart api. Native
# tools (web search, file search, memory, ...) and MCP servers aren't
# affected by this list -- they follow endpoints.agents.capabilities below.
includedTools:
  - ask_user_question
  - calculator

mcpSettings:
  allowedAddresses:
    - 'mcp-agent-skills:8321'
    - 'mcp-kb:8322'
    - 'mcp-figma:3333'

endpoints:
  custom:
    - name: 'OpenAI Compatible'
      apiKey: '${VLLM_API_KEY}'
      baseURL: '${VLLM_BASE_URL}'
      models:
        # VLLM_DEFAULT_MODEL (.env) is the model id this endpoint's backend
        # actually serves -- whatever that id looks like, it's an opaque
        # label to LibreChat's routing; the tokenConfig entry below is keyed
        # to the same id and is what stops LibreChat inferring vendor-specific
        # behavior from the name alone. fetch pulls the live id list from
        # GET {baseURL}/models on its own; the `default` value here is only
        # the fallback LibreChat uses if that fetch call fails.
        default: ['REPLACE_ME_VLLM_DEFAULT_MODEL']
        fetch: true
      titleConvo: true
      titleModel: 'REPLACE_ME_VLLM_DEFAULT_MODEL'
      modelDisplayLabel: 'Qwen3.6-35B-A3B'
      # Reasoning ("thinking") for this gateway, probed against both models it
      # serves (GET {baseURL}/models):
      # - reasoningKey: the gateway returns thinking text in `reasoning`
      #   (message and stream delta), not the `reasoning_content` LibreChat
      #   reads from custom endpoints by default -- without this the UI shows
      #   no thinking at all.
      # - reasoningFormat: effort goes out as top-level `reasoning_effort`.
      # - reasoning_effort options: the gateway accepts none (thinking off),
      #   low, medium and xhigh (its default), and rejects minimal/high/max
      #   with a 400 -- so the selector offers only those. '' is LibreChat's
      #   "Auto": send nothing, the gateway default applies. This list is per
      #   endpoint, not per model: a model with a different set needs its own
      #   endpoint entry.
      customParams:
        defaultParamsEndpoint: 'custom'
        reasoningKey: 'reasoning'
        reasoningFormat: 'reasoning_effort'
        paramDefinitions:
          - key: 'reasoning_effort'
            options: ['', 'none', 'low', 'medium', 'xhigh']
      tokenConfig:
        REPLACE_ME_VLLM_DEFAULT_MODEL:
          context: REPLACE_ME_MODEL_CONTEXT_TOKENS
          prompt: 0
          completion: 0

  agents:
    recursionLimit: REPLACE_ME_AGENTS_RECURSION_LIMIT
    maxRecursionLimit: REPLACE_ME_AGENTS_MAX_RECURSION_LIMIT
    allowedProviders: ['OpenAI Compatible']
    # LibreChat's default capability set minus execute_code ("Run Code"),
    # which needs a LibreChat Code API this stack doesn't run. This list
    # REPLACES the default rather than trimming it, so a capability LibreChat
    # adds to its defaults in a later release stays off until listed here.
    # Re-enable Run Code by adding execute_code (once a Code API is configured).
    capabilities:
      - deferred_tools
      - file_search
      - web_search
      - artifacts
      - subagents
      - actions
      - context
      - skills
      - memory
      - ask_user_question
      - tools
      - chain
      - ocr
    # mode: bypass -- any tool call NOT matched below (every jira_*/
    # confluence_* read, doc_gen, get_skill, list_skills, ...) runs without
    # a prompt. `ask` is the actual allowlist of write/mutating calls that
    # still pause for a human decision -- add the equivalent write tools
    # here for any future toolset, same "<toolset>_<action>" naming
    # (mcp-server/lib/mcp_tools.py's f"{toolset}_{spec.name}"). This stacks
    # with (doesn't replace) each toolset's own --confirm/*_AUTO_CONFIRM_WRITES
    # code gate -- see agent-skills/AGENTS.md's confirm-gating convention.
    #
    # Pattern format: LibreChat's docs show "mcp:<server>:<tool>", but that
    # does NOT match in practice -- toolApproval's ask/allow/deny patterns
    # are matched as a LITERAL anchored glob (`^pattern$`, only `*` is a
    # wildcard; `:` is not a delimiter) directly against the real
    # model-facing tool name. Confirmed two ways: reading
    # createToolPolicyHook's globToRegex in danny-avila/agents (no
    # colon-handling at all) and, more concretely, querying this
    # deployment's own `agents` Mongo collection (`db.agents.find(...,
    # {tools:1})`) for a persisted agent with agent-skills tools attached --
    # its `tools` array holds literal entries like
    # "jira_transition_mcp_agent-skills" (toolset_action + the SDK's
    # `_mcp_<server>` suffix, per librechat-data-provider's
    # `Constants.mcp_delimiter`), never anything colon-shaped. The original
    # "mcp:agent-skills:jira_transition" pattern silently matched nothing,
    # so jira_transition fell through to `mode: bypass` and ran unasked --
    # that's the bug just hit live. Fixed below to the real names.
    toolApproval:
      enabled: true
      mode: bypass
      ask:
        - 'jira_transition_mcp_agent-skills'
        - 'jira_worklog_mcp_agent-skills'
        - 'jira_worklog_edit_mcp_agent-skills'
        - 'jira_worklog_delete_mcp_agent-skills'
        - 'jira_create_issue_mcp_agent-skills'
        - 'jira_edit_issue_mcp_agent-skills'
        - 'confluence_create_page_mcp_agent-skills'
        - 'confluence_update_page_mcp_agent-skills'
        - 'confluence_patch_page_mcp_agent-skills'
        - 'confluence_delete_page_mcp_agent-skills'
        - 'confluence_add_comment_mcp_agent-skills'
        - 'confluence_add_label_mcp_agent-skills'
        - 'confluence_remove_label_mcp_agent-skills'
        - 'glab_add_mr_note_mcp_agent-skills'
        - 'glab_add_mr_discussion_mcp_agent-skills'
        - 'glab_edit_mr_note_mcp_agent-skills'
        - 'glab_delete_mr_note_mcp_agent-skills'
        - 'jira_upload_attachment_mcp_agent-skills'
        - 'jira_delete_attachment_mcp_agent-skills'
        - 'confluence_upload_attachment_mcp_agent-skills'
        - 'confluence_delete_attachment_mcp_agent-skills'
      reason: 'The actions writing data must be approved by the user -- review before it runs.'

mcpServers:
  agent-skills:
    type: streamable-http
    url: http://mcp-agent-skills:8321/mcp
    # mcp-server/lib/execute.py caps each CLI subprocess at 60s; this must
    # stay above that or a legitimately-running call gets aborted client-side.
    timeout: 90000
    initTimeout: 20000
    serverInstructions: true
    chatMenu: true
    # Per-user Jira/Confluence credentials: LibreChat substitutes each
    # user's own customUserVars value into these headers on every request
    # to mcp-agent-skills. mcp-server only honors them because
    # MCP_TRUST_REQUEST_CREDENTIALS=1 is set for that service
    # (docker-compose.yml) -- see agent-skills/AUTHENTICATION.md, Part 2.
    # A server with customUserVars gets a per-user connection automatically
    # (never a shared app-level one), so two LibreChat users never share a
    # Jira or Confluence identity through this server. Both toolsets'
    # base URLs are per-user too, by deliberate choice here -- not just the
    # credential -- so there's no shared server-level instance URL either.
    #
    # Every customUserVars entry is required: LibreChat (v0.8.8) has no
    # optional flag, and a user with any of them blank gets none of this
    # server's tools. So a value a user doesn't have is entered as `-`:
    # mcp-agent-skills runs with MCP_UNSET_HEADER_VALUE=- (docker-compose.yml),
    # which treats a `-` header as "not set" for that call -- never as a
    # value, and never filled from the server's own environment. A user
    # without GitLab enters `-` in both GitLab fields; Jira and Confluence
    # keep working, and glab_* calls report the variables as not set.
    # There is deliberately no default-project field for GitLab: a personal
    # access token reaches every project the user can, so requests name
    # their project.
    headers:
      X-Agent-Skills-Env-JIRA_BASE_URL: '{{JIRA_BASE_URL}}'
      X-Agent-Skills-Env-JIRA_USERNAME: '{{JIRA_USERNAME}}'
      X-Agent-Skills-Env-JIRA_PASSWORD: '{{JIRA_PASSWORD}}'
      X-Agent-Skills-Env-JIRA_DEFAULT_PROJECT: '{{JIRA_DEFAULT_PROJECT}}'
      X-Agent-Skills-Env-CONFLUENCE_BASE_URL: '{{CONFLUENCE_BASE_URL}}'
      X-Agent-Skills-Env-CONFLUENCE_USERNAME: '{{CONFLUENCE_USERNAME}}'
      X-Agent-Skills-Env-CONFLUENCE_PASSWORD: '{{CONFLUENCE_PASSWORD}}'
      X-Agent-Skills-Env-CONFLUENCE_DEFAULT_SPACE: '{{CONFLUENCE_DEFAULT_SPACE}}'
      X-Agent-Skills-Env-GITLAB_BASE_URL: '{{GITLAB_BASE_URL}}'
      X-Agent-Skills-Env-GITLAB_TOKEN: '{{GITLAB_TOKEN}}'
      # Not a credential: names whose upload folder this request may attach
      # files from (docker-compose.yml, AGENT_SKILLS_ATTACHMENT_DIR). Filled
      # by LibreChat from the signed-in user, never by the user.
      X-Agent-Skills-User: '{{LIBRECHAT_USER_ID}}'
    customUserVars:
      JIRA_BASE_URL:
        title: 'Jira server URL'
        description: 'Jira server URL'
        sensitive: false
      JIRA_USERNAME:
        title: 'Jira username'
        description: 'Your own Jira username -- used only for your Jira tool calls, never stored by agent-skills itself.'
        sensitive: false
      JIRA_PASSWORD:
        title: 'Jira password'
        description: 'Jira password -- used only for your Jira tool calls, never stored by agent-skills itself.'
        sensitive: true
      JIRA_DEFAULT_PROJECT:
        title: 'Jira default project'
        description: 'Jira default project board -- used for your Jira tool calls'
        sensitive: false
      CONFLUENCE_BASE_URL:
        title: 'Confluence server URL'
        description: 'Confluence server URL'
        sensitive: false
      CONFLUENCE_USERNAME:
        title: 'Confluence username'
        description: 'Your own Confluence username -- used only for your Confluence tool calls, never stored by agent-skills itself.'
        sensitive: false
      CONFLUENCE_PASSWORD:
        title: 'Confluence password'
        description: 'Confluence password -- used only for your Confluence tool calls, never stored by agent-skills itself.'
        sensitive: true
      CONFLUENCE_DEFAULT_SPACE:
        title: 'Confluence default space'
        description: 'Confluence default space key -- used for your Confluence tool calls when a space is not given explicitly'
        sensitive: false
      GITLAB_BASE_URL:
        title: 'GitLab server URL (type - if you do not use GitLab)'
        description: 'If you do not use GitLab, type a single dash: - . LibreChat requires every field to be filled, and a dash means "not set". Otherwise your GitLab server URL, e.g. https://gitlab.example.com.'
        sensitive: false
      GITLAB_TOKEN:
        title: 'GitLab access token (type - if you do not use GitLab)'
        description: 'If you do not use GitLab, type a single dash: - . LibreChat requires every field to be filled, and a dash means "not set". Otherwise your own GitLab personal access token, created under your profile (User settings > Access tokens): read_api to read, api to also comment on merge requests. It reaches every project you can. Used only for your GitLab tool calls, never stored by agent-skills itself.'
        sensitive: true

  # The knowledge catalog (this repo's own kb/ module): what knowledge exists
  # in the organization and where it lives. Deliberately has no customUserVars
  # and no headers -- unlike agent-skills, the catalog is shared, so there is
  # nothing per-user to inject. Both its tools are read-only, so nothing here
  # needs a toolApproval entry. Permission-sensitive content is never in the
  # catalog: agents follow each hit's `fetch` hint and read the real document
  # with the user's own credentials, through agent-skills.
  kb:
    type: streamable-http
    url: http://mcp-kb:8322/mcp
    timeout: 30000
    initTimeout: 20000
    serverInstructions: true
    chatMenu: true

  # Figma design data (the mcp-figma service -- Framelink's community server on
  # Figma's REST API, not Figma's hosted mcp.figma.com, which rejects
  # LibreChat at OAuth client registration; see docs/FIGMA.md). One read-only
  # tool, get_figma_data (file key + optional node id, both taken from a
  # pasted Figma link), so nothing here needs a toolApproval entry.
  #
  # Per-user, the same way agent-skills' Jira/Confluence credentials are: each
  # user pastes their own Figma personal access token into this server's
  # customUserVars form, and LibreChat sends it on every request as
  # X-Figma-Token, which mcp-figma uses for that request only. mcp-figma holds
  # no token of its own, so a user who hasn't set one reads nothing -- there is
  # no shared fallback identity -- and each user only sees the files their own
  # Figma account can open.
  figma:
    type: streamable-http
    url: http://mcp-figma:3333/mcp
    # One call can fetch and simplify a whole design file, which takes a while
    # on a large one; asking for a single node (a link with ?node-id=) is much
    # faster.
    timeout: 120000
    initTimeout: 20000
    chatMenu: true
    headers:
      X-Figma-Token: '{{FIGMA_API_KEY}}'
    customUserVars:
      FIGMA_API_KEY:
        title: 'Figma personal access token'
        description: 'Create one in Figma under Settings > Security > Personal access tokens, with the "File content: Read" and "Dev resources: Read" scopes. Used only for your own Figma tool calls, never stored by mcp-figma.'
        sensitive: true

webSearch:
  searchProvider: 'searxng'
  # A literal URL here didn't work -- provider eligibility appears to be
  # keyed off the SEARXNG_INSTANCE_URL env var directly, not this YAML
  # value, so it must be an env reference matching the documented
  # pattern (see .env's SEARXNG_INSTANCE_URL).
  searxngInstanceUrl: '${SEARXNG_INSTANCE_URL}'
  # LibreChat's web search needs a scraper as well as a search provider (it
  # stays disabled without one). The in-Docker crw service stands in for a
  # self-hosted Firecrawl; both values are env references for the same reason
  # as searxngInstanceUrl. FIRECRAWL_API_KEY is a placeholder (see .env).
  # Configured here for every user, so nobody is asked for web-search keys.
  scraperProvider: 'firecrawl'
  firecrawlApiUrl: '${FIRECRAWL_API_URL}'
  firecrawlApiKey: '${FIRECRAWL_API_KEY}'
  # The rerankers (Jina, Cohere) are paid APIs; results keep SearXNG's order.
  rerankerType: 'none'
  # webSearch has its own SSRF allowlist, separate from mcpSettings' --
  # confirmed by hitting "SSRF protection: searxng resolved to blocked
  # address" with only mcpSettings.allowedAddresses set.
  allowedAddresses:
    - 'searxng:8080'
    - 'crw:3000'
