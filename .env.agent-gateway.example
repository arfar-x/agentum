# Settings for the agent gateway (profile `gateway`). Copy to .env.agent-gateway and chmod 600.
# The model it calls comes from VLLM_BASE_URL / VLLM_API_KEY / VLLM_DEFAULT_MODEL in .env.

# Postgres for the gateway's own state. The password appears twice -- here and in DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://gateway:<POSTGRES_PASSWORD>@gateway-db:5432/gateway

# Fernet key that encrypts stored credentials and paused turns. Losing it makes them unreadable.
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDS_KEY=

# Signs approval codes.
#   openssl rand -hex 32
APPROVAL_SECRET=
