# Settings for the agent gateway (profile `gateway`). Copy to .env.agent-gateway and chmod 600.
# The model it calls comes from VLLM_BASE_URL / VLLM_API_KEY / VLLM_DEFAULT_MODEL in .env.

# Postgres for the gateway's own state. The password appears twice -- here and in DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://gateway:<POSTGRES_PASSWORD>@gateway-db:5432/gateway

# Fernet key that encrypts stored credentials and paused turns. Losing it makes them unreadable.
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDS_KEY=

# Signs approval codes.
#   openssl rand -hex 32
APPROVAL_SECRET=

### ---- Identity and access (specs/003-identity-access) ----
# Who the callers are comes from Keycloak (the realm your Keycloak administrator made; docs/KEYCLOAK_ADMIN_SETUP.md, see
# docs/KEYCLOAK.md). Groups, roles and accounts are managed there, never here.

# Which identity provider adapter to build. `keycloak` is the only one implemented.
IDENTITY_PROVIDER=keycloak
# The realm's address, exactly as it appears in tokens (the `iss` claim), e.g.
# https://kc.example.org/realms/agentflow. Required. Reached from this container.
OIDC_ISSUER=
# The audience tokens must carry: the realm's audience-only client.
OIDC_AUDIENCE=agent-gateway
# Seconds the provider's signing keys are cached.
OIDC_JWKS_TTL=600

# The read-only service account that copies people, groups and roles into the gateway every
# DIRECTORY_SYNC_SECONDS. Required. The administrator gives you the secret; on the local dev Keycloak `make idp-realm-apply` writes it.
DIRECTORY_CLIENT_ID=agent-gateway-directory
DIRECTORY_CLIENT_SECRET=
DIRECTORY_SYNC_SECONDS=300
# Callers who use a model key (not a token) are refused beyond this age of the copy. At least 2x the interval.
DIRECTORY_MAX_STALE_SECONDS=900

# The portal (/portal: model key, tool credentials, Telegram link). Leave PORTAL_BASE_URL empty to
# turn it off; set it to the gateway's public address (https://gw.example.org) to turn it on, which
# also needs the next two. The administrator gives you PORTAL_CLIENT_SECRET (the local dev Keycloak's `make idp-realm-apply` writes it).
PORTAL_BASE_URL=
PORTAL_CLIENT_ID=agent-gateway-portal
PORTAL_CLIENT_SECRET=
# Signs the portal's cookies; at least 32 bytes.   openssl rand -hex 32
PORTAL_SESSION_SECRET=

# Allow the gateway to issue its own `agk_` keys (for clients that cannot sign in or hold a model key).
GATEWAY_ISSUE_KEYS=false

# Whether a person's own model key may also identify them when presented as the bearer:
#   off        never; only Keycloak tokens and issued keys identify a caller
#   read-only  only if exactly one person registered that string, and then with no write tools and no
#              raw model pass-through (default)
#   full       same uniqueness rule, with the person's full permissions
# A string several people registered identifies nobody (401 model_key_shared). There is no shared
# model key: a person who has not registered one gets 403 upstream_key_required.
GATEWAY_MODEL_KEY_LOGIN=read-only

# Shared with mcp-kb (kb/.env) so group names the gateway forwards are believed. Empty: no identity
# is forwarded and restricted sources stay hidden. `make kb-setup` generates it in kb/.env and copies
# it here when this file exists.
KB_TRUST_SECRET=

# How long the audit log is kept, in days.
AUDIT_RETENTION_DAYS=365
