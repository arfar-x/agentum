.env
# (also matches module env files such as kb/.env; each module's tracked
# template is its .env.example)
backups/
*.env.bak
# real secret_key generated from searxng/settings.yml.example -- see
# scripts/bootstrap.sh and docs/OPERATIONS.md
searxng/settings.yml
# real source configuration -- space keys, repo paths, project keys. The
# tracked template is kb/config/sources.yaml.example
kb/config/sources.yaml

# rendered from config/librechat.yaml.example + .env by
# scripts/render-librechat-config.sh (make up / make render-config) --
# edit the .example file, never this one
config/librechat.yaml
# editor swap/backup files -- .env is edited often enough that these
# are worth excluding explicitly rather than trusting every editor's
# own global ignore config
.*.swp
.*.swo
*~

# Local state and config of AI coding agents -- per-developer, not part of
# this repo. (Project instructions live in AGENTS.md, which every tool reads;
# CLAUDE.md is a symlink to it.) The exception is .claude/skills/, which holds
# the Spec Kit skills (/speckit-*) installed by `specify init` and shared by
# everyone working on the specs under specs/.
.kilo/
.claude/*
!.claude/skills/
.cursor/
.codex/
.gemini/
.opencode/
.roo/
.cline/
.windsurf/
.continue/

# Python build/test artifacts from kb/ (see kb/README.md for the venv setup --
# the virtualenv and the editable install's metadata are per-developer, like
# the AI-agent directories above)
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/

# the agent gateway's secrets (copy .env.agent-gateway.example)
.env.agent-gateway

# the Keycloak integration's settings (copy integrations/keycloak/.env.keycloak.example)
integrations/keycloak/.env.keycloak

# the gateway's former standalone repository, kept for its history (restore with: mv agent-gateway/.git.standalone agent-gateway/.git)
agent-gateway/.git.standalone/
