# The stack's variables for the Telegram bot. Copy to integrations/telegram-bot/.env (`make telegram-up` does
# it and fills the generated values).

# From @BotFather.
BOT_TOKEN=

# The OpenAI-compatible endpoint the bot talks to. The default is agent-gateway on the shared
# network; any endpoint that serves /v1/chat/completions and /v1/models works.
OPENAI_BASE_URL=http://agent-gateway:8080/v1
# Optional: used only to list models before a user is linked.
OPENAI_API_KEY=
# The model (or agent) a new conversation starts with. Users change it with /model.
DEFAULT_MODEL=

# How users link their Telegram account. `device` (recommended, needs the identity provider; see
# docs/KEYCLOAK.md): /login shows a code, the person approves it at the identity provider and the
# bot acts as them. `pairing`: an operator approves a code and the bot uses a gateway-issued key
# (needs GATEWAY_ISSUE_KEYS=true on the gateway). Device mode is available after the bot's device
# sign-in lands (specs/003-identity-access).
LINK_MODE=pairing
# Device mode only. The issuer URL must be the one in the tokens (the realm's address as people and
# this container reach it), and the bot must be able to reach it. The client is the realm's public
# `telegram-bot` client (made by `make idp-realm-apply`); it has no secret.
OIDC_ISSUER=
OIDC_CLIENT_ID=telegram-bot
OIDC_SCOPE=openid offline_access

# The bot's own database on gateway-db. DB_PASSWORD appears twice -- here and in DATABASE_URL.
DB_PASSWORD=
DATABASE_URL=postgresql://telegram_bot:<DB_PASSWORD>@gateway-db:5432/telegram_bot
# Encrypts the API keys stored for linked users. Losing it means re-pairing everyone.
CREDS_KEY=

# A 👀 on a message only when it is worth it: it waits behind a running turn, or its answer takes
# longer than REACTION_DELAY seconds. Removed when that message has been answered.
REACTIONS=true
REACTION_DELAY=10
# Show the endpoint's reasoning as one silent, self-editing message.
SHOW_PROGRESS=false
# Seconds before a request to the endpoint is given up.
REQUEST_TIMEOUT=600

# Webhook instead of long polling: set both (the secret is required with the URL).
WEBHOOK_URL=
WEBHOOK_SECRET=
