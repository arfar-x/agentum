# Settings for integrations/keycloak/apply.sh (and `make idp-up` for a local dev Keycloak).
# Copy to integrations/keycloak/.env.keycloak and chmod 600 (`make idp-realm-apply` does it).
# Keycloak itself is not deployed by this stack -- it is the one you already run, or the throwaway
# one `make idp-up` starts for development. Plain KEY=value lines.

# Base URL of the Keycloak server, as the machine running apply.sh reaches it.
KEYCLOAK_URL=http://localhost:8480
# The realm the stack uses. Created on first apply; other realms are never touched.
KEYCLOAK_REALM=agentflow
# An administrator of the master realm, used by apply.sh only (never by the gateway). For a real
# server use a dedicated admin, and remove the line once you are done if you prefer.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
# Public base URL of the agent gateway, for the portal's redirect addresses. Must be what browsers
# use (https://gw.example.org). Changing it and re-applying updates the portal client.
GATEWAY_PUBLIC_URL=http://localhost:8090

# --- only for `make idp-up` (a local, throwaway Keycloak; data is lost when it is removed) ---
KEYCLOAK_DEV_IMAGE=quay.io/keycloak/keycloak:26.8.1
KEYCLOAK_DEV_PORT=8480
