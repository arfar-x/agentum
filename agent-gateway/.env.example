# Where the agents' model calls go (an OpenAI-compatible base URL, ending in /v1).
UPSTREAM_BASE_URL=http://localhost:8000/v1
# The model agents use unless a request says otherwise; referenced as ${DEFAULT_MODEL} in config/agents.
DEFAULT_MODEL=
# Context window (tokens) of the model, reported on /v1/models. Per-model overrides: config/gateway.yaml.
MODEL_CONTEXT_TOKENS=
DATABASE_URL=postgresql://gateway:change-me@localhost:5432/gateway
REDIS_URL=redis://localhost:6379/0
# Fernet key that encrypts stored credentials and paused turns. Losing it makes them unreadable.
CREDS_KEY=
# Signs approval codes.
APPROVAL_SECRET=
GATEWAY_PORT=8080
